# Banco (Docker). Use a mesma senha nas duas linhas. Porta 5433: veja o docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=servicos_db
DATABASE_URL=postgresql://postgres:SENHA@localhost:5433/servicos_db

# API
# Dois segredos DIFERENTES, longos e aleatórios (mínimo 32 caracteres). Para gerar cada um:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=
FRONTEND_URL=http://localhost:5173
NOMINATIM_USER_AGENT=pontelo-projeto-academico

# Front-end (o Vite só expõe as variáveis que começam com VITE_)
VITE_API_URL=http://localhost:3000/api/v1
VITE_USAR_EXEMPLOS=true

# Usuário moderador criado pelo "npm run seed" (só para desenvolvimento)
SEED_EMAIL_MODERADOR=moderador@pontelo.test
SEED_SENHA_MODERADOR=
